# fin_dash environment file. Copy this file to .env (same folder as app.py) and fill in your own values.
# app.py loads .env automatically on startup — no export needed. A variable already exported in your shell always wins over .env.
# .env is gitignored: never commit it, and run: chmod 600 .env
# Copy to .env (gitignored) only if you want Finnhub quotes.
# Without it, fin_dash falls back to free Stooq end-of-day data.
FINNHUB_API_KEY=
# Optional: PORT=5001  FIN_DASH_DB=/path/to/fin_dash.db

# Plaid (self-hosted only, optional). Start with sandbox.
# PLAID_CLIENT_ID=
# PLAID_SECRET=
# PLAID_ENV=sandbox
